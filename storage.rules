rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Lessons storage rules
    match /lessons/{visibility}/{allPaths=**} {
      allow read: if visibility == 'public' || visibility == 'unlisted' || request.auth != null;
      allow write: if request.auth != null || true; // Allow teacher uploads
    }
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}
