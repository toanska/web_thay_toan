rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // -------------------------------------------------------------------------
    // Phase 3: Primitive Definitions
    // -------------------------------------------------------------------------
    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    // Check role from the users collection
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      let role = getUserData().role;
      return isSignedIn() && (role == 'admin' || role == 'teacher');
    }

    // -------------------------------------------------------------------------
    // Global Safety Net
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Validation Helpers (Anti-Update-Gap)
    // -------------------------------------------------------------------------
    
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'role', 'code', 'email', 'school']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 256 &&
             data.role in ['student', 'teacher', 'admin', 'guest'] &&
             data.code is string && data.code.size() <= 64;
    }

    function isValidExam(data) {
      return data.keys().hasAll(['id', 'title', 'code', 'subject', 'grade']) &&
             data.id is string &&
             data.title is string && data.title.size() <= 512 &&
             data.grade is number;
    }

    function isValidAttempt(data) {
      return data.keys().hasAll(['id', 'examId', 'studentId', 'score', 'submittedAt']) &&
             data.score is number && data.score >= 0 && data.score <= 10;
    }

    // -------------------------------------------------------------------------
    // Collection Match Blocks
    // -------------------------------------------------------------------------

    // Users
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidUser(incoming());
      // For updates, we allow any signed in user to update (for the PIN login system)
      // but in a production app we'd restrict this to owner or admin.
      allow update: if isSignedIn() && isValidUser(incoming());
      allow delete: if isAdmin();
    }

    // Questions
    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Exams
    match /exams/{examId} {
      allow read: if true; // Exams list is public
      allow create, update: if isAdmin() && isValidExam(incoming());
      allow delete: if isAdmin();
    }

    // Attempts
    match /attempts/{attemptId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidAttempt(incoming());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // News
    match /news/{newsId} {
      allow read: if true; // Public announcements
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Materials
    match /materials/{materialId} {
      allow read: if true; // Public materials
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
